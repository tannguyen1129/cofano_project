# Copy to .env (or export) before running the dashboard.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Bind address. Keep 127.0.0.1 unless the two DASHBOARD_* variables below are set.
HOST=127.0.0.1

# HTTP Basic Auth. Required whenever HOST is not 127.0.0.1 — the dashboard has no
# application-level login, so these credentials are the only thing protecting it.
# DASHBOARD_USER=cofano
# DASHBOARD_PASSWORD=change-me
