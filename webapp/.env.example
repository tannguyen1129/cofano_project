# Copy to .env (or export) before running the dashboard.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Bind address. Behind nginx/Cloudflare keep this on 127.0.0.1.
HOST=127.0.0.1

# Login gate (forecast.gate.LoginRequiredMiddleware). When DASHBOARD_PASSWORD is set, the whole
# dashboard requires signing in at /login; unset it only for open localhost dev.
DASHBOARD_USER=cofano
DASHBOARD_PASSWORD=change-me
