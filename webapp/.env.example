# Copy to .env (or export) before running the dashboard.
# The dashboard has NO authentication — keep it on localhost or behind a trusted proxy.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# HOST=0.0.0.0        # only behind a reverse proxy on a trusted network
