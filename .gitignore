# Regenerated on each run — not committed
outputs/

# Real secrets — never commit (only .env.example is tracked)
.env
*.env
!*.env.example

# Webapp runtime/build artifacts
webapp/frontend/node_modules/
webapp/frontend/.next/
webapp/backend/db.sqlite3
webapp/backend/staticfiles/
*.log

# Python cruft
.ipynb_checkpoints/
__pycache__/
*.pyc
/content/

# OS
.DS_Store

# NOTE: model/model_bundle.pkl and webapp/frontend/out/ ARE committed (deliverables).
